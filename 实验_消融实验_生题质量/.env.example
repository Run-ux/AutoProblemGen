# 生题质量消融实验本地 LLM 配置。
# 复制为 .env 后填写真实密钥；真实 .env 不应提交。

# 生成/评审模型：用于 no_tuple、no_rules、no_quality_loop 和 LLM judge 的对话接口。
GENERATION_API_KEY=
GENERATION_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-v4-pro
GENERATION_TIMEOUT_SECONDS=1200
GENERATION_MAX_RETRIES=3
GENERATION_TEMPERATURE=0.3

# Embedding 模型：用于 schema distance 和 changed axes 等语义向量计算。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_TIMEOUT_SECONDS=1200
EMBEDDING_MAX_RETRIES=3
