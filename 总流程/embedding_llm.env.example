# Embedding 模型服务配置，用于题面生成阶段的语义向量计算。
# 这组配置只影响 embedding 请求，不直接控制生成文本的随机性。

# API_KEY：Embedding 服务鉴权密钥。
# 留空会在启动时直接报错；更换密钥只影响可用额度、权限和计费归属，不改变生成逻辑。
API_KEY=

# BASE_URL：OpenAI 兼容格式的 API 根地址，程序会拼接 /embeddings 调用向量接口。
# 修改为其他服务商时，需要同时确认 MODEL 是该服务支持的 embedding 模型；网络延迟和稳定性会影响总流程耗时。
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MODEL：用于计算文本向量的 embedding 模型。
# 模型会影响语义匹配、规则选择和相似度判断；更强或维度更合适的模型通常更稳，但可能更慢或更贵。
MODEL=text-embedding-v4

# TIMEOUT_SECONDS：单次 embedding HTTP 请求的最长等待时间，单位秒。
# 调大可减少慢请求超时报错，代价是异常时等待更久；调小能更快失败，但容易误伤正常慢请求。
TIMEOUT_SECONDS=1200

# MAX_RETRIES：embedding 请求失败后的最多尝试次数。
# 调大可提高临时网络/限流情况下的成功率，但会增加最坏耗时和接口调用次数；必须是正整数。
MAX_RETRIES=3
