# 生成模型服务配置，用于四元组抽取、题面生成、质量迭代和验证阶段的 LLM 调用。
# 修改这组参数会直接影响生成质量、稳定性、速度和成本。

# API_KEY：生成模型服务鉴权密钥。
# 留空会在启动或首次调用时直接报错；更换密钥只影响可用额度、权限和计费归属，不改变提示词或流程逻辑。
API_KEY=

# BASE_URL：OpenAI 兼容格式的 API 根地址，程序会拼接 /chat/completions 调用对话接口。
# 修改为其他服务商时，需要同时确认 MODEL 可用；服务延迟、限流策略和兼容性会影响生成成功率。
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MODEL：负责生成与审校的对话模型。
# 更强模型通常能提升题面创新度、约束一致性和代码/验证产物质量，但会增加成本和耗时；较弱模型可能更快但更容易出现逻辑缺口。
MODEL=qwen3.6-plus

# TIMEOUT_SECONDS：单次生成模型 HTTP 请求的最长等待时间，单位秒。
# 生成长题面、标准解法或复杂验证产物时可能需要较长时间；调小会更快失败，调大会拉长异常场景下的等待。
TIMEOUT_SECONDS=1200

# MAX_RETRIES：生成模型请求失败后的最多尝试次数。
# 调大可提高临时网络错误、限流或服务抖动时的成功率，但会增加最坏耗时和接口调用次数；必须是正整数。
MAX_RETRIES=3

# TEMPERATURE：生成采样温度，控制输出随机性。
# 较低值（如 0.0-0.3）更稳定、可复现，适合保证格式和逻辑一致；较高值会增加变化和创意，但也更容易产生不一致或不可验证内容。
TEMPERATURE=0.2
