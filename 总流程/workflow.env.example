# 总流程配置：控制输入输出位置、质量迭代和本地验证资源。
# 路径可以写绝对路径，也可以写相对本文件所在目录的路径。

# INPUT_PATH：待处理的原始题目输入路径。
# 可以是单个 JSON 文件，也可以是包含多个单题 JSON 的目录；目录模式会跳过 manifest.json。输入越多，总耗时和模型调用次数越多。
INPUT_PATH=D:\AutoProblemGen\爬取题目\output\taco\sample_400_autoproblemgen

# OUTPUT_ROOT：总流程输出根目录。
# 每次运行会在这里创建 RUN_ID 对应的子目录，保存四元组、生成产物、验证结果、日志和 workflow_summary.json。
OUTPUT_ROOT=D:\AutoProblemGen\总流程\output

# RUN_ID：本次运行的标识。
# 留空会自动使用当前时间；手动指定便于复现实验和对比结果，但重复使用同一个 RUN_ID 可能覆盖或混杂已有输出。
RUN_ID=

# QUALITY_ITERATIONS：每个生成结果的质量评价/修订轮数，只允许 1、2 或 3，不能关闭质量评价。
# 调大通常能提高约束完整性和可验证性，但会增加模型调用和耗时；调小更快，但更依赖首轮生成质量。
QUALITY_ITERATIONS=3

# QUALITY_FULL_SCORE_MAX_ITERATIONS：当质量评价已满分时，最多允许继续尝试的轮数，必须是正整数。
# 调大可能继续寻找更优表达或更稳版本，但收益会递减；调小可减少满分后继续打磨带来的额外成本。
QUALITY_FULL_SCORE_MAX_ITERATIONS=10

# VERIFICATION_TIMEOUT_SECONDS：单个生成结果验证子流程的总超时时间，单位秒，必须大于 0。
# 调大适合复杂题面、慢模型或重验证流程；调小能更快发现卡死，但可能让可通过的复杂结果验证失败。
VERIFICATION_TIMEOUT_SECONDS=3600

# PYTHON_EXECUTABLE：运行各阶段子进程使用的 Python 可执行文件。
# 留空使用当前解释器；指定虚拟环境路径可控制依赖版本，错误路径会导致流程无法启动子阶段。
PYTHON_EXECUTABLE=

# GENERATION_LLM_CONFIG：生成模型配置文件路径。
# 影响四元组抽取、题面生成、质量迭代和验证中的 LLM 生成质量、速度与成本。
GENERATION_LLM_CONFIG=D:\AutoProblemGen\总流程\generation_llm.env

# EMBEDDING_LLM_CONFIG：Embedding 模型配置文件路径。
# 影响语义向量计算、相似度匹配和规则选择稳定性；通常需要与所选服务商的 embedding 接口保持一致。
EMBEDDING_LLM_CONFIG=D:\AutoProblemGen\总流程\embedding_llm.env

# EXECUTION_TEST_INPUT_TIMEOUT_SECONDS：运行“测试输入生成器”的单次超时时间，单位秒。
# 调大可容忍较慢的测试生成代码，调小能更快拦截死循环或低效实现。
EXECUTION_TEST_INPUT_TIMEOUT_SECONDS=5

# EXECUTION_TEST_INPUT_MEMORY_LIMIT_MB：运行“测试输入生成器”的内存上限，单位 MB。
# 调大可容忍更大的构造过程，调小能更早发现异常占用；过低可能误杀正常生成器。
EXECUTION_TEST_INPUT_MEMORY_LIMIT_MB=512

# EXECUTION_BRUTEFORCE_TIMEOUT_SECONDS：运行暴力解/参考校验逻辑的单次超时时间，单位秒。
# 调大适合规模稍大的随机对拍，调小能更快暴露暴力解复杂度过高或卡死问题。
EXECUTION_BRUTEFORCE_TIMEOUT_SECONDS=5

# EXECUTION_BRUTEFORCE_MEMORY_LIMIT_MB：运行暴力解/参考校验逻辑的内存上限，单位 MB。
# 调大会放宽验证资源，调小会更严格地筛掉高内存实现。
EXECUTION_BRUTEFORCE_MEMORY_LIMIT_MB=512

# EXECUTION_CHECKER_TIMEOUT_SECONDS：运行 checker 或标准解对拍检查的单次超时时间，单位秒。
# 调大可减少复杂 checker 的误超时，调小能更快发现低效 checker 或标准解执行问题。
EXECUTION_CHECKER_TIMEOUT_SECONDS=5

# EXECUTION_CHECKER_MEMORY_LIMIT_MB：运行 checker 或标准解对拍检查的内存上限，单位 MB。
# 调大可容忍更重的检查逻辑，调小会更严格地限制验证阶段资源。
EXECUTION_CHECKER_MEMORY_LIMIT_MB=512
